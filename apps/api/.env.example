# Copy to .env and adjust. `.env` is gitignored; this file is not.

# Matches docker-compose.yml at the repo root — a local Postgres 16 container
# with POSTGRES_PASSWORD=devpassword and POSTGRES_DB=estatemax.
# Run `docker compose up -d` before `pnpm prisma:migrate`.
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/estatemax?schema=public"

# Redis 7, also from docker-compose.yml.
REDIS_URL="redis://localhost:6379"

PORT=8000
NODE_ENV=development
